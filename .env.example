# Frontend (Vite) environment — copy to .env.local to override. All optional.

# Leave EMPTY for local dev: the browser calls same-origin /api/... and the Vite
# dev/preview server proxies it to the backend (see vite.config.ts).
# Set only to call a remote backend directly (backend CORS_ORIGINS must allow this origin).
# VITE_API_URL=https://api.example.com

# Where the Vite proxy forwards /api in dev/preview (default http://127.0.0.1:8001).
# VITE_PROXY_TARGET=http://127.0.0.1:8001
