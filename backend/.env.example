# EHS Backend Environment Configuration
# Set your Neon PostgreSQL connection string here or in your deployment environment
# Format: postgresql://[user]:[password]@[neon-hostname]/[dbname]?sslmode=require
DATABASE_URL=postgresql://neondb_owner:npg_placeholder@ep-cool-project-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Application settings
ENVIRONMENT=development
API_V1_STR=/api/v1
PROJECT_NAME="EHS & Safety AI Platform"

# Dedicated PostgreSQL Schema for EHS Agent isolation
DB_SCHEMA=ehs_core

# DomoGPT AI Configuration (replace placeholder with your real Domo Developer Token)
DOMO_BASE_URL=https://gwcteq-partner.domo.com
DOMO_AI_ENDPOINT=/api/ai/v1/text/generation
DOMO_AI_MODEL=domo.domo_ai.domogpt-large-v2.2:anthropic
DOMO_DEVELOPER_TOKEN=your_domo_developer_token_here
DOMO_TIMEOUT_SECONDS=45
DOMO_MAX_RETRIES=2



# Browser origins allowed to call the API directly (comma-separated).
# Defaults cover Vite dev (3000), Vite default (5173) and preview (4173).
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
