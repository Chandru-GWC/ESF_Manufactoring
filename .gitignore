# Environment files (never commit credentials or database URLs)
.env
.env.*
!.env.example

# Frontend build & dependencies
node_modules/
dist/
.vite/
frontend/public/media/*.mp4
frontend/public/media/*.webm

# Python virtualenvs & caches (backend is managed with uv; commit pyproject.toml + uv.lock)
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Local databases & temporary scripts
*.db
*.sqlite
scratch/

# Nested third-party repo (own .git, venv, demo videos) - not part of this repo
backend/vendor/OpenFall/

# Large model weights and temporary uploads (reproducible or too large for git)
backend/models_cache/
backend/storage/tmp_uploads/
*.pt
*.onnx

# Local tooling state
.claude/settings.local.json
.playwright-mcp/
